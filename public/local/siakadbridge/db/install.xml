      </KEYS>
      <INDEXES>
        <INDEX NAME="kodetagihan_uix" UNIQUE="true" FIELDS="kodetagihan"/>
        <INDEX NAME="mahasiswa_status_ix" UNIQUE="false" FIELDS="mahasiswaid,status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
