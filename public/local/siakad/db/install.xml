<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/siakad/db" VERSION="20260729" COMMENT="Moodle-side SIAKAD configuration. The SIAKAD master data lives in its own database, see db/install_external.xml."
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_siakad_quizprodi" COMMENT="Quiz target programmes and payment rule">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="prodiid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="local_siakad_prodi row in the SIAKAD database; no foreign key, that table may live on another server."/>
        <FIELD NAME="period" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="requirepaid" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="quiz_fk" TYPE="foreign" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="quiz_prodi_uniq" UNIQUE="true" FIELDS="quizid,prodiid"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
